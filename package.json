{
  "name": "@syscli/mytpe",
  "version": "0.1.0",
  "description": "Typed MyTPE Pay API client for Node. Payment links, terminals, forms, and webhooks for card payments in Algeria. Server-side only.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SYSCLI/mytpe-node.git"
  },
  "homepage": "https://github.com/SYSCLI/mytpe-node#readme",
  "bugs": {
    "url": "https://github.com/SYSCLI/mytpe-node/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.check.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "mytpe",
    "algeria",
    "payment",
    "satim",
    "cib",
    "edahabia",
    "payment-link",
    "webhooks",
    "api",
    "sdk"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "msw": "^2.14.6",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
